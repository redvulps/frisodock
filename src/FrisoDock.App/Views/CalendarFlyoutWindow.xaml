<Window x:Class="FrisoDock.App.Views.CalendarFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FrisoDock.App.ViewModels"
        xmlns:core="clr-namespace:FrisoDock.Core.Models;assembly=FrisoDock.Core"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:CalendarFlyoutViewModel}"
        Title="FrisoDock Calendar"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="Transparent">

    <!--
        AllowsTransparency stays off so the DWM can draw the acrylic behind the window; the
        transparent background comes from the CompositionTarget, in FlyoutChrome.
    -->

    <Window.Resources>

        <SolidColorBrush x:Key="TextBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A7A80" />
        <SolidColorBrush x:Key="HoverBrush" Color="#1AFFFFFF" />

        <!--
            Measured on the quick settings panel, which shares the material: the line separating
            the header from the grid is white at 8% over the panel background.
        -->
        <SolidColorBrush x:Key="SeparatorBrush" Color="#15FFFFFF" />

        <!--
            The same veil as the quick settings panel, for the same reason: the acrylic the DWM
            gives transient windows is the menu one, lighter than the Windows 11 panels.
        -->
        <SolidColorBrush x:Key="ScrimBrush" Color="#B316171F" />

        <!-- Chromeless button, for the month navigation arrows. -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!--
        The radius follows the corners the DWM rounds: the veil is painted by WPF, and a full
        rectangle would square the panel corners.
    -->
    <Border Width="338" Background="{StaticResource ScrimBrush}" CornerRadius="8">
        <StackPanel>

            <!-- Header: today, in full, as in the native flyout. It does not navigate along. -->
            <TextBlock Text="{Binding Header, Mode=OneTime}"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="14"
                       Margin="16,11,16,11" />

            <Rectangle Height="1" Fill="{StaticResource SeparatorBrush}" />

            <!-- Month and year on the left; navigation arrows on the right, as in the native flyout. -->
            <Grid Margin="16,6,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Month.Caption}"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding PreviousMonthCommand}"
                        ToolTip="Mês anterior">
                    <TextBlock Text="&#xEDDB;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="10" />
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding NextMonthCommand}"
                        ToolTip="Próximo mês">
                    <TextBlock Text="&#xEDDC;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="10" />
                </Button>
            </Grid>

            <!-- Weekday letters, in the order the culture dictates. -->
            <ItemsControl ItemsSource="{Binding Month.DayHeaders}" Margin="8,26,8,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Height="20" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--
                The grid always has six weeks (CalendarMonthBuilder): the panel height does not
                change while navigating, and the window does not resize under the cursor.
            -->
            <ItemsControl ItemsSource="{Binding Month.Days}" Margin="8,0,8,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:CalendarDay}">
                        <Grid Height="36">
                            <!--
                                Today's circle uses the user's accent color, like the native
                                one; the text over it is derived from that color
                                (AccentPalettes), otherwise a light accent would wash the
                                number out.
                            -->
                            <Ellipse x:Name="TodayCircle"
                                     Width="30"
                                     Height="30"
                                     Fill="{DynamicResource AccentBrush}"
                                     Visibility="Collapsed" />
                            <TextBlock x:Name="DayText"
                                       Text="{Binding Number}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                <Setter TargetName="DayText" Property="Foreground" Value="{StaticResource MutedBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="TodayCircle" Property="Visibility" Value="Visible" />
                                <Setter TargetName="DayText" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </Border>
</Window>
