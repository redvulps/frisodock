<Window x:Class="FrisoDock.App.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FrisoDock.App.Localization"
        xmlns:vm="clr-namespace:FrisoDock.App.ViewModels"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:DockViewModel}"
        Title="FrisoDock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Left="0"
        Top="0"
        Width="200"
        Height="60">

    <!--
        Background nulo, e não Transparent: a janela é maior que o painel, e um fundo transparente
        continua sendo alvo de clique — a folga em volta da barra viraria uma faixa morta que
        engole cliques destinados à janela de baixo. Sem fundo, o clique atravessa.

        Nenhuma medida está chumbada neste arquivo. Tudo vem de DockAppearance, que deriva das
        mesmas DockMetrics usadas para dimensionar a janela. Chumbar valores aqui faria o painel
        divergir do conteúdo e cortar o último ícone.
    -->

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <!-- Palette: translucent dark, in the spirit of dash-to-dock. -->
        <SolidColorBrush x:Key="PanelBrush" Color="#D91B1B1F" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="RunningIndicatorBrush" Color="#8AB4F8" />
        <SolidColorBrush x:Key="ActiveIndicatorBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="HoverBrush" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="StartGlyphBrush" Color="#E8EAED" />
        <SolidColorBrush x:Key="ClockDateBrush" Color="#A8ADB4" />
        <SolidColorBrush x:Key="MenuBrush" Color="#F21B1B1F" />
        <SolidColorBrush x:Key="MenuTextBrush" Color="#E8EAED" />

        <!-- Panel context menu, in the same look as the dock. -->
        <Style x:Key="DockMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource MenuTextBrush}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Item de submenu com marca de seleção: a bolinha à esquerda diz qual borda está em
            uso. IsChecked é lido uma vez, sem notificação — trocar de borda refaz o dock, e o
            menu novo nasce com a marca certa.
        -->
        <Style x:Key="DockRadioMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource MenuTextBrush}" />
            <Setter Property="Padding" Value="10,7,14,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Check"
                                         Width="5"
                                         Height="5"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource MenuTextBrush}"
                                         Visibility="Hidden" />
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Cabeçalho de submenu. Precisa de template próprio porque o DockMenuItemStyle não tem
            Popup: um MenuItem com filhos e sem Popup no template simplesmente não abre nada.
            O fundo do submenu repete o do menu, para os dois parecerem um só.
        -->
        <Style x:Key="DockSubmenuHeaderStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource MenuTextBrush}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           Text="&#xE76C;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="10"
                                           Margin="18,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MenuTextBrush}" />

                                <Popup Placement="Right"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade">
                                    <Border Background="{StaticResource MenuBrush}"
                                            BorderBrush="{StaticResource PanelBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="4"
                                            Margin="4,0,0,0">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DockContextMenuStyle" TargetType="ContextMenu">
            <!-- HasDropShadow turns on the popup transparency, without which the rounding does not show. -->
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource MenuBrush}"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="4">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Rótulo do app. Flutua acima do ícone ampliado, e não no cursor: no cursor ele cobre
            dois ou três ícones vizinhos, que é justamente o que se quer ler.
        -->
        <Style x:Key="DockToolTipStyle" TargetType="ToolTip">
            <Setter Property="Placement" Value="Custom" />
            <!-- HasDropShadow turns on the popup transparency, without which the rounding does not show. -->
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource MenuTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{StaticResource MenuBrush}"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,5">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Botão sem cromo: o conteúdo é o ícone, e o realce de hover é um retângulo
            arredondado por trás dele.
        -->
        <Style x:Key="DockButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width"
                    Value="{Binding DataContext.Appearance.IconSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Height"
                    Value="{Binding DataContext.Appearance.IconSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="{Binding DataContext.Appearance.ItemCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!--
        A janela é mais alta que o painel: a faixa transparente de cima recebe o ícone ampliado,
        que transborda para fora da barra como no dock do macOS. O painel fica ancorado embaixo.
    -->
    <Grid>
        <!--
            HorizontalAlignment centralizado, e não esticado: o painel tem a largura do conteúdo e
            cresce para os dois lados quando os ícones ampliados empurram os vizinhos. Esticado,
            ele ocuparia também a folga lateral transparente da janela.
        -->
        <Border x:Name="PanelBorder"
                VerticalAlignment="{Binding Appearance.PanelVerticalAlignment}"
                HorizontalAlignment="{Binding Appearance.PanelHorizontalAlignment}"
                MouseMove="OnPanelMouseMove"
                MouseLeave="OnPanelMouseLeave"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="{Binding Appearance.PanelBorderThickness}"
                CornerRadius="{Binding Appearance.PanelCornerRadius}"
                Padding="{Binding Appearance.PanelPadding}">

        <!--
            Menu do dock. Vale para o fundo do painel, os vãos entre ícones, o separador e o
            botão Iniciar. Os ícones de app suprimem o evento e terão o próprio menu mais adiante.
        -->
        <Border.ContextMenu>
            <ContextMenu Style="{StaticResource DockContextMenuStyle}">
                <MenuItem Header="{loc:Tr MenuDockPosition}"
                          Style="{StaticResource DockSubmenuHeaderStyle}">
                    <MenuItem Header="{loc:Tr EdgeBottom}"
                              Style="{StaticResource DockRadioMenuItemStyle}"
                              IsChecked="{Binding IsEdgeBottom, Mode=OneTime}"
                              Click="OnEdgeBottomMenuClick" />
                    <MenuItem Header="{loc:Tr EdgeTop}"
                              Style="{StaticResource DockRadioMenuItemStyle}"
                              IsChecked="{Binding IsEdgeTop, Mode=OneTime}"
                              Click="OnEdgeTopMenuClick" />
                    <MenuItem Header="{loc:Tr EdgeLeft}"
                              Style="{StaticResource DockRadioMenuItemStyle}"
                              IsChecked="{Binding IsEdgeLeft, Mode=OneTime}"
                              Click="OnEdgeLeftMenuClick" />
                    <MenuItem Header="{loc:Tr EdgeRight}"
                              Style="{StaticResource DockRadioMenuItemStyle}"
                              IsChecked="{Binding IsEdgeRight, Mode=OneTime}"
                              Click="OnEdgeRightMenuClick" />
                </MenuItem>
                <MenuItem Header="{loc:Tr MenuSettings}"
                          Style="{StaticResource DockMenuItemStyle}"
                          Click="OnSettingsMenuClick" />
                <MenuItem Header="{loc:Tr MenuExit}"
                          Style="{StaticResource DockMenuItemStyle}"
                          Command="{Binding ExitCommand}" />
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel Orientation="{Binding Appearance.StripOrientation}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <!--
                Botão Iniciar: dispara a tecla Windows, e o menu abre acima do dock.

                O clique é tratado no pressionar, não pelo Command (que dispara no soltar): quando
                o Iniciar já está aberto, o clique no dock tira o foco dele e ele fecha sozinho, e
                só o estado lido antes disso diz se é para abrir ou deixar fechar. No soltar já
                seria tarde — o Iniciar já teria começado a sumir.
            -->
            <Button x:Name="StartButton"
                    Style="{StaticResource DockButtonStyle}"
                    PreviewMouseLeftButtonDown="OnStartButtonMouseDown"
                    ToolTip="{loc:Tr DockStart}">
                <Path Width="{Binding Appearance.IconImageSize}"
                      Height="{Binding Appearance.IconImageSize}"
                      Stretch="Uniform"
                      Fill="{StaticResource StartGlyphBrush}"
                      Data="M0,0 L9,0 L9,9 L0,9 Z M11,0 L20,0 L20,9 L11,9 Z M0,11 L9,11 L9,20 L0,20 Z M11,11 L20,11 L20,20 L11,20 Z" />
            </Button>

            <Rectangle Width="{Binding Appearance.SeparatorWidth}"
                       Height="{Binding Appearance.SeparatorHeight}"
                       Margin="{Binding Appearance.SeparatorMargin}"
                       Fill="{StaticResource PanelBorderBrush}" />

            <ItemsControl x:Name="AppItems"
                          ItemsSource="{Binding Items}"
                          PreviewMouseLeftButtonDown="OnAppItemsMouseDown"
                          PreviewMouseLeftButtonUp="OnAppItemsMouseUp"
                          LostMouseCapture="OnAppItemsLostMouseCapture">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="{Binding DataContext.Appearance.StripOrientation, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DockItemViewModel}">
                        <Button Style="{StaticResource DockButtonStyle}"
                                ToolTipOpening="OnAppIconToolTipOpening"
                                ContextMenuOpening="OnAppIconContextMenuOpening"
                                MouseEnter="OnAppIconMouseEnter"
                                MouseLeave="OnAppIconMouseLeave"
                                Margin="{Binding DataContext.Appearance.ItemMargin, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource DockToolTipStyle}"
                                         Content="{Binding DisplayName}" />
                            </Button.ToolTip>

                            <Grid>
                                <Image Source="{Binding Icon}"
                                       Width="{Binding DataContext.Appearance.IconImageSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Height="{Binding DataContext.Appearance.IconImageSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                <!-- Running app indicator, on the face turned towards the screen edge. -->
                                <Border x:Name="RunningIndicator"
                                        Height="{Binding DataContext.Appearance.IndicatorHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Width="{Binding DataContext.Appearance.IndicatorWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CornerRadius="2"
                                        Margin="{Binding DataContext.Appearance.IndicatorMargin, RelativeSource={RelativeSource AncestorType=Window}}"
                                        VerticalAlignment="{Binding DataContext.Appearance.IndicatorVerticalAlignment, RelativeSource={RelativeSource AncestorType=Window}}"
                                        HorizontalAlignment="{Binding DataContext.Appearance.IndicatorHorizontalAlignment, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Background="{StaticResource RunningIndicatorBrush}"
                                        Visibility="Collapsed" />
                            </Grid>

                            <Button.InputBindings>
                                <MouseBinding MouseAction="MiddleClick"
                                              Command="{Binding LaunchNewInstanceCommand}" />
                            </Button.InputBindings>
                        </Button>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter TargetName="RunningIndicator"
                                        Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="RunningIndicator"
                                        Property="Background"
                                        Value="{StaticResource ActiveIndicatorBrush}" />
                                <Setter TargetName="RunningIndicator"
                                        Property="Width"
                                        Value="{Binding DataContext.Appearance.IndicatorActiveWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Setter TargetName="RunningIndicator"
                                        Property="Height"
                                        Value="{Binding DataContext.Appearance.IndicatorActiveHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Fixed block on the right, as on the native taskbar. -->
            <Rectangle Width="{Binding Appearance.SeparatorWidth}"
                       Height="{Binding Appearance.SeparatorHeight}"
                       Margin="{Binding Appearance.SeparatorMargin}"
                       Fill="{StaticResource PanelBorderBrush}" />

            <Button x:Name="TrayButton"
                    Style="{StaticResource DockButtonStyle}"
                    Click="OnTrayButtonClick"
                    ToolTip="{loc:Tr DockTrayIcons}">
                <TextBlock Text="&#xE70E;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="13"
                           Foreground="{StaticResource StartGlyphBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Button>

            <!-- Network, sound and battery group: it is the quick settings panel button. -->
            <Button x:Name="QuickSettingsButton"
                    Style="{StaticResource DockButtonStyle}"
                    Width="{Binding Appearance.QuickStatusButtonWidth}"
                    Height="{Binding Appearance.QuickStatusButtonHeight}"
                    Click="OnQuickSettingsButtonClick"
                    ToolTip="{Binding QuickStatus.Tooltip}">
                <StackPanel Orientation="{Binding Appearance.QuickStatusOrientation}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{Binding QuickStatus.NetworkGlyph}"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{StaticResource StartGlyphBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding QuickStatus.VolumeGlyph}"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14"
                               Margin="{Binding Appearance.QuickStatusGlyphMargin}"
                               Foreground="{StaticResource StartGlyphBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding QuickStatus.BatteryGlyph}"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="15"
                               Margin="{Binding Appearance.QuickStatusGlyphMargin}"
                               Foreground="{StaticResource StartGlyphBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding QuickStatus.HasBattery, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
            </Button>

            <!--
                The clock is the calendar button. The Background moves from the attribute into
                the style: a local value beats the trigger, and the hover highlight would
                never show.
            -->
            <Border x:Name="ClockBlock"
                    Width="{Binding Appearance.ClockBlockWidth}"
                    Height="{Binding Appearance.ClockBlockHeight}"
                    Margin="{Binding Appearance.ClockBlockMargin}"
                    CornerRadius="{Binding Appearance.ItemCornerRadius}"
                    Cursor="Hand"
                    MouseLeftButtonDown="OnClockPress"
                    MouseLeftButtonUp="OnClockClick"
                    ToolTip="{Binding Clock.Tooltip}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <!--
                    Grade, e não pilha: no dock vertical a data vem em cima e a hora embaixo, e a
                    ordem troca pela linha de cada uma em vez de por dois blocos alternativos.
                -->
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="{Binding Appearance.ClockTimeRow}"
                               Text="{Binding Clock.Time}"
                               FontSize="{Binding Appearance.ClockTimeFontSize}"
                               Margin="{Binding Appearance.ClockTimeMargin}"
                               Foreground="{StaticResource StartGlyphBrush}"
                               HorizontalAlignment="Center" />

                    <TextBlock Grid.Row="{Binding Appearance.ClockDateRow}"
                               Text="{Binding Clock.Date}"
                               FontSize="{Binding Appearance.ClockDateFontSize}"
                               Margin="{Binding Appearance.ClockDateMargin}"
                               Foreground="{StaticResource ClockDateBrush}"
                               HorizontalAlignment="Center" />
                </Grid>
            </Border>

        </StackPanel>
        </Border>
    </Grid>
</Window>
