<Window x:Class="FrisoDock.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FrisoDock.App.ViewModels"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Configurações do FrisoDock"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Width="620"
        Height="430"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="Transparent">

    <!--
        Sem AllowsTransparency: é o que permite ao DWM desenhar o acrílico e arredondar os
        cantos, o mesmo acabamento dos flyouts. Ver FlyoutChrome.

        Tamanho fixo, e não SizeToContent: com as categorias em abas, a janela mudaria de altura
        a cada troca de aba, e o botão Fechar saltaria de lugar debaixo do cursor. A altura é a
        da categoria mais alta, e as menores sobram espaço — que é o que o Windows faz.
    -->

    <Window.Resources>

        <SolidColorBrush x:Key="TextBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A0A0A0" />
        <SolidColorBrush x:Key="TrackBrush" Color="#3D3D3D" />
        <SolidColorBrush x:Key="ThumbBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="SeparatorBrush" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="NavSelectedBrush" Color="#1FFFFFFF" />

        <!-- Toggle in the Windows 11 shape: rounded track with the thumb sliding.  -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="40"
                                Height="20"
                                CornerRadius="10"
                                Background="{StaticResource TrackBrush}"
                                BorderBrush="{StaticResource MutedBrush}"
                                BorderThickness="1">
                            <Ellipse x:Name="Thumb"
                                     Width="12"
                                     Height="12"
                                     Margin="4,0,0,0"
                                     HorizontalAlignment="Left"
                                     Fill="{StaticResource ThumbBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Track"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Thumb"
                                        Property="HorizontalAlignment"
                                        Value="Right" />
                                <Setter TargetName="Thumb"
                                        Property="Margin"
                                        Value="0,0,4,0" />
                                <Setter TargetName="Thumb"
                                        Property="Fill"
                                        Value="#000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Escolha exclusiva que ocupa a linha inteira. Um anel isolado teria uma área clicável
            ínfima — só o traço, porque um Grid sem fundo e um anel sem preenchimento não recebem
            hit test no vazio —, e acertá-lo com o mouse é quase impossível. Aqui o RadioButton é a
            linha toda: o título e a explicação entram como Content, o anel fica à direita como
            indicador, e clicar em qualquer ponto da linha seleciona. É o que o Windows 11 faz.
        -->
        <Style x:Key="RadioRowStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Padding="14,11"
                                CornerRadius="6"
                                Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  Margin="0,0,16,0"
                                                  VerticalAlignment="Center" />

                                <Grid Grid.Column="1" Width="20" Height="20" VerticalAlignment="Center">
                                    <Ellipse x:Name="Ring"
                                             Width="18"
                                             Height="18"
                                             Stroke="{StaticResource MutedBrush}"
                                             StrokeThickness="1" />
                                    <Ellipse x:Name="Dot"
                                             Width="8"
                                             Height="8"
                                             Fill="#000000"
                                             Visibility="Collapsed" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Botão de diálogo no formato do Windows 11. Precisa de template próprio: sem ele o
            WPF cai no template padrão, que no hover pinta o azul-claro do Aero — cor que não
            existe em lugar nenhum deste painel, e que sobre o texto claro fica ilegível.
        -->
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#2D2D2D" />
            <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="4"
                                BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#383838" />
                            </Trigger>

                            <!-- Pressed darkens instead of lightening, like the system buttons. -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#272727" />
                                <Setter TargetName="Root" Property="TextElement.Foreground" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings row: label and explanation on the left, control on the right. -->
        <Style x:Key="SettingRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                </Trigger>

                <!-- An option that does not apply now has to look like it; blocking the click alone says nothing. -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="SettingHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--
            Item da navegação lateral, no formato das Configurações do Windows 11: a barrinha de
            destaque à esquerda marca a categoria aberta. O glifo vem do Tag do item, e não de
            uma propriedade nova, porque é a única coisa que varia além do texto.
        -->
        <Style x:Key="NavItemStyle" TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand" />

            <!--
                Focusable fica ligado (o padrão): o TabItem acopla a seleção ao foco, e
                OnMouseLeftButtonDown só marca IsSelected se conseguir focar. Com Focusable=False
                o clique não trocava de aba. O retângulo de foco pontilhado é suprimido à parte —
                ele só apareceria na navegação por teclado, e aqui destoa do resto do painel.
            -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root"
                                CornerRadius="4"
                                Margin="0,1"
                                Padding="10,9"
                                Background="Transparent">
                            <Grid>
                                <Rectangle x:Name="Accent"
                                           Width="3"
                                           Height="16"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           HorizontalAlignment="Left"
                                           Fill="{DynamicResource AccentBrush}"
                                           Visibility="Collapsed" />

                                <StackPanel Orientation="Horizontal" Margin="13,0,0,0">
                                    <TextBlock Text="{TemplateBinding Tag}"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15"
                                               Width="20"
                                               Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" />

                                    <ContentPresenter ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      TextElement.FontSize="13"
                                                      TextElement.Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            O TabControl entra só como mecanismo de seleção; a moldura padrão dele — fundo,
            borda e a fila de abas em cima — é inteiramente substituída pela navegação lateral.
        -->
        <Style x:Key="SettingsTabsStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="184" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" IsItemsHost="True" Margin="4,0" />

                            <Rectangle Grid.Column="1"
                                       Width="1"
                                       Fill="{StaticResource SeparatorBrush}"
                                       Margin="6,2" />

                            <!-- Scrolling per category: one of them may grow past the fixed height. -->
                            <ScrollViewer Grid.Column="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,4,0">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </ScrollViewer>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Configurações"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="18"
                           Margin="14,6,14,2" />
                <TextBlock Text="As mudanças valem na hora e ficam guardadas."
                           Style="{StaticResource SettingHintStyle}"
                           Margin="14,0,14,8" />

                <Rectangle Height="1" Fill="{StaticResource SeparatorBrush}" Margin="10,0,10,8" />
            </StackPanel>

            <TabControl Grid.Row="1" Style="{StaticResource SettingsTabsStyle}">

                <TabItem Header="Aparência" Tag="&#xE771;" Style="{StaticResource NavItemStyle}">
                    <StackPanel>

                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Ampliar o ícone sob o cursor"
                                               Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="O ícone cresce por cima da barra, e os vizinhos acompanham."
                                               Style="{StaticResource SettingHintStyle}" />
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding EnableMagnification}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRowStyle}"
                                IsEnabled="{Binding EnableMagnification}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Intensidade da ampliação"
                                               Style="{StaticResource SettingTitleStyle}" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding MagnificationScale, StringFormat={}{0:0.0}x}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <Slider Minimum="{Binding MinimumMagnification}"
                                        Maximum="{Binding MaximumMagnification}"
                                        Value="{Binding MagnificationScale}"
                                        TickFrequency="0.1"
                                        IsSnapToTickEnabled="True"
                                        Margin="0,8,0,0"
                                        Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Miniaturas das janelas"
                                               Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Ao pousar o mouse num app aberto, mostra o que há em cada janela."
                                               Style="{StaticResource SettingHintStyle}" />
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding EnableWindowPreviews}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Exibir os segundos"
                                               Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="O relógio passa a contar de segundo em segundo, e a barra alarga para caber."
                                               Style="{StaticResource SettingHintStyle}" />
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding ShowClockSeconds}" />
                            </Grid>
                        </Border>

                    </StackPanel>
                </TabItem>

                <TabItem Header="Posição" Tag="&#xE90E;" Style="{StaticResource NavItemStyle}">
                    <StackPanel>

                        <RadioButton GroupName="Edge"
                                     Style="{StaticResource RadioRowStyle}"
                                     IsChecked="{Binding EdgeBottom}">
                            <StackPanel>
                                <TextBlock Text="Inferior" Style="{StaticResource SettingTitleStyle}" />
                                <TextBlock Text="O padrão: o dock fica na borda de baixo, onde a barra de tarefas ficava."
                                           Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="Edge"
                                     Style="{StaticResource RadioRowStyle}"
                                     IsChecked="{Binding EdgeTop}">
                            <StackPanel>
                                <TextBlock Text="Superior" Style="{StaticResource SettingTitleStyle}" />
                                <TextBlock Text="O dock fica na borda de cima, e os menus abrem para baixo."
                                           Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="Edge"
                                     Style="{StaticResource RadioRowStyle}"
                                     IsChecked="{Binding EdgeLeft}">
                            <StackPanel>
                                <TextBlock Text="Esquerda" Style="{StaticResource SettingTitleStyle}" />
                                <TextBlock Text="Dock vertical na borda esquerda, como no GNOME."
                                           Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="Edge"
                                     Style="{StaticResource RadioRowStyle}"
                                     IsChecked="{Binding EdgeRight}">
                            <StackPanel>
                                <TextBlock Text="Direita" Style="{StaticResource SettingTitleStyle}" />
                                <TextBlock Text="Dock vertical na borda direita."
                                           Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                        </RadioButton>

                    </StackPanel>
                </TabItem>

                <TabItem Header="Esconder o dock" Tag="&#xE890;" Style="{StaticResource NavItemStyle}">
                    <StackPanel>

                        <RadioButton GroupName="HideMode"
                                     Style="{StaticResource RadioRowStyle}"
                                     IsChecked="{Binding HideNever}">
                            <StackPanel>
                                <TextBlock Text="Nunca" Style="{StaticResource SettingTitleStyle}" />
                                <TextBlock Text="O dock fica na borda o tempo todo."
                                           Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="HideMode"
                                     Style="{StaticResource RadioRowStyle}"
                                     IsChecked="{Binding HideWhenWindowOverlaps}">
                            <StackPanel>
                                <TextBlock Text="Quando uma janela ocupa o lugar dele"
                                           Style="{StaticResource SettingTitleStyle}" />
                                <TextBlock Text="Com a área livre o dock continua à vista; some quando alguma janela chega ali."
                                           Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="HideMode"
                                     Style="{StaticResource RadioRowStyle}"
                                     IsChecked="{Binding HideAlways}">
                            <StackPanel>
                                <TextBlock Text="Sempre" Style="{StaticResource SettingTitleStyle}" />
                                <TextBlock Text="O dock só aparece quando o cursor encosta na borda da tela."
                                           Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                        </RadioButton>

                    </StackPanel>
                </TabItem>

                <TabItem Header="Alternar janelas" Tag="&#xE7C4;" Style="{StaticResource NavItemStyle}">
                    <StackPanel>

                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Usar ALT+Tab agrupado por aplicativo"
                                               Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Um item por app em vez de um por janela; ao chegar num app, entra pela janela que estava em uso. Desligado, vale o ALT+Tab do Windows."
                                               Style="{StaticResource SettingHintStyle}" />
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding UseGroupedWindowSwitcher}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Alternar entre janelas do mesmo app (ALT+&#x27;)"
                                               Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Com ALT segurado, a tecla ' percorre as janelas do app em foco, ao estilo do macOS."
                                               Style="{StaticResource SettingHintStyle}" />
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding UseSameAppWindowSwitcher}" />
                            </Grid>
                        </Border>

                    </StackPanel>
                </TabItem>

                <TabItem Header="Monitores" Tag="&#xE7F4;" Style="{StaticResource NavItemStyle}">
                    <StackPanel>

                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Exibir em todos os monitores"
                                               Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Um dock em cada tela. Desligado, o dock fica só no monitor principal."
                                               Style="{StaticResource SettingHintStyle}" />
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding ShowOnAllMonitors}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRowStyle}"
                                IsEnabled="{Binding CanIsolateMonitorApps}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Exibir somente apps presentes no monitor"
                                               Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Cada dock mostra só as janelas da sua tela. Os apps fixados continuam em todos."
                                               Style="{StaticResource SettingHintStyle}" />
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding IsolateMonitorApps}" />
                            </Grid>
                        </Border>

                    </StackPanel>
                </TabItem>

                <TabItem Header="Área de trabalho" Tag="&#xE7F8;" Style="{StaticResource NavItemStyle}">
                    <StackPanel>

                        <Border Style="{StaticResource SettingRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Esconder a barra de tarefas do Windows"
                                               Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Desligar traz a barra nativa de volta sem fechar o dock."
                                               Style="{StaticResource SettingHintStyle}" />
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding HideNativeTaskbar}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRowStyle}"
                                IsEnabled="{Binding CanReserveScreenSpace}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Reservar espaço na tela"
                                               Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Impede que janelas maximizadas fiquem por baixo do dock. Só vale com o dock sempre à vista."
                                               Style="{StaticResource SettingHintStyle}" />
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding ReserveScreenSpace}" />
                            </Grid>
                        </Border>

                    </StackPanel>
                </TabItem>

            </TabControl>

            <Button Grid.Row="2"
                    Content="Fechar"
                    Click="OnCloseClick"
                    HorizontalAlignment="Right"
                    Margin="14,10,14,6"
                    Style="{StaticResource DialogButtonStyle}" />

        </Grid>
    </Border>
</Window>
