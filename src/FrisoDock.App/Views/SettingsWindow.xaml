<Window x:Class="FrisoDock.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FrisoDock.App.ViewModels"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Configurações do FrisoDock"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height"
        Width="420"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="Transparent">

    <!--
        Sem AllowsTransparency: é o que permite ao DWM desenhar o acrílico e arredondar os
        cantos, o mesmo acabamento dos flyouts. Ver FlyoutChrome.
    -->

    <Window.Resources>

        <SolidColorBrush x:Key="TextBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A0A0A0" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
        <SolidColorBrush x:Key="TrackBrush" Color="#3D3D3D" />
        <SolidColorBrush x:Key="ThumbBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="SeparatorBrush" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF" />

        <!-- Toggle in the Windows 11 shape: rounded track with the thumb sliding.  -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="40"
                                Height="20"
                                CornerRadius="10"
                                Background="{StaticResource TrackBrush}"
                                BorderBrush="{StaticResource MutedBrush}"
                                BorderThickness="1">
                            <Ellipse x:Name="Thumb"
                                     Width="12"
                                     Height="12"
                                     Margin="4,0,0,0"
                                     HorizontalAlignment="Left"
                                     Fill="{StaticResource ThumbBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track"
                                        Property="Background"
                                        Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Track"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Thumb"
                                        Property="HorizontalAlignment"
                                        Value="Right" />
                                <Setter TargetName="Thumb"
                                        Property="Margin"
                                        Value="0,0,4,0" />
                                <Setter TargetName="Thumb"
                                        Property="Fill"
                                        Value="#000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Exclusive choice, in the Windows 11 shape: a ring with the dot at the centre. -->
        <Style x:Key="RadioStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="20" Height="20">
                            <Ellipse x:Name="Ring"
                                     Width="18"
                                     Height="18"
                                     Stroke="{StaticResource MutedBrush}"
                                     StrokeThickness="1" />
                            <Ellipse x:Name="Dot"
                                     Width="8"
                                     Height="8"
                                     Fill="#000000"
                                     Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Fill" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings row: label and explanation on the left, control on the right. -->
        <Style x:Key="SettingRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                </Trigger>

                <!-- An option that does not apply now has to look like it; blocking the click alone says nothing. -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="SettingHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

    </Window.Resources>

    <Border Padding="10">
        <StackPanel>

            <TextBlock Text="Configurações"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="18"
                       Margin="14,8,14,2" />
            <TextBlock Text="As mudanças valem na hora e ficam guardadas."
                       Style="{StaticResource SettingHintStyle}"
                       Margin="14,0,14,10" />

            <Rectangle Height="1" Fill="{StaticResource SeparatorBrush}" Margin="10,0,10,6" />

            <!-- Appearance -->
            <TextBlock Text="APARÊNCIA"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="11"
                       Margin="14,8,14,4" />

            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Ampliar o ícone sob o cursor"
                                   Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock Text="O ícone cresce por cima da barra, e os vizinhos acompanham."
                                   Style="{StaticResource SettingHintStyle}" />
                    </StackPanel>

                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding EnableMagnification}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingRowStyle}"
                    IsEnabled="{Binding EnableMagnification}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Intensidade da ampliação"
                                   Style="{StaticResource SettingTitleStyle}" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding MagnificationScale, StringFormat={}{0:0.0}x}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Slider Minimum="{Binding MinimumMagnification}"
                            Maximum="{Binding MaximumMagnification}"
                            Value="{Binding MagnificationScale}"
                            TickFrequency="0.1"
                            IsSnapToTickEnabled="True"
                            Margin="0,8,0,0"
                            Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Miniaturas das janelas"
                                   Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock Text="Ao pousar o mouse num app aberto, mostra o que há em cada janela."
                                   Style="{StaticResource SettingHintStyle}" />
                    </StackPanel>

                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding EnableWindowPreviews}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Exibir os segundos"
                                   Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock Text="O relógio passa a contar de segundo em segundo, e a barra alarga para caber."
                                   Style="{StaticResource SettingHintStyle}" />
                    </StackPanel>

                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding ShowClockSeconds}" />
                </Grid>
            </Border>

            <Rectangle Height="1" Fill="{StaticResource SeparatorBrush}" Margin="10,8,10,0" />

            <!-- Behaviour -->
            <TextBlock Text="ESCONDER O DOCK"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="11"
                       Margin="14,10,14,4" />

            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Nunca" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock Text="O dock fica na borda o tempo todo."
                                   Style="{StaticResource SettingHintStyle}" />
                    </StackPanel>

                    <RadioButton Grid.Column="1"
                                 GroupName="HideMode"
                                 Style="{StaticResource RadioStyle}"
                                 IsChecked="{Binding HideNever}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Quando uma janela ocupa o lugar dele"
                                   Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock Text="Com a área livre o dock continua à vista; some quando alguma janela chega ali."
                                   Style="{StaticResource SettingHintStyle}" />
                    </StackPanel>

                    <RadioButton Grid.Column="1"
                                 GroupName="HideMode"
                                 Style="{StaticResource RadioStyle}"
                                 IsChecked="{Binding HideWhenWindowOverlaps}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Sempre" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock Text="O dock só aparece quando o cursor encosta na borda da tela."
                                   Style="{StaticResource SettingHintStyle}" />
                    </StackPanel>

                    <RadioButton Grid.Column="1"
                                 GroupName="HideMode"
                                 Style="{StaticResource RadioStyle}"
                                 IsChecked="{Binding HideAlways}" />
                </Grid>
            </Border>

            <Rectangle Height="1" Fill="{StaticResource SeparatorBrush}" Margin="10,8,10,0" />

            <!-- Desktop -->
            <TextBlock Text="ÁREA DE TRABALHO"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="11"
                       Margin="14,10,14,4" />

            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Esconder a barra de tarefas do Windows"
                                   Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock Text="Desligar traz a barra nativa de volta sem fechar o dock."
                                   Style="{StaticResource SettingHintStyle}" />
                    </StackPanel>

                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding HideNativeTaskbar}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingRowStyle}"
                    IsEnabled="{Binding CanReserveScreenSpace}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Reservar espaço na tela"
                                   Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock Text="Impede que janelas maximizadas fiquem por baixo do dock. Só vale com o dock sempre à vista."
                                   Style="{StaticResource SettingHintStyle}" />
                    </StackPanel>

                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding ReserveScreenSpace}" />
                </Grid>
            </Border>

            <Button Content="Fechar"
                    Click="OnCloseClick"
                    HorizontalAlignment="Right"
                    Margin="14,12,14,8"
                    Padding="18,7"
                    Cursor="Hand"
                    Foreground="{StaticResource TextBrush}"
                    Background="#2D2D2D"
                    BorderBrush="{StaticResource SeparatorBrush}"
                    BorderThickness="1" />

        </StackPanel>
    </Border>
</Window>
