<Window x:Class="FrisoDock.App.Views.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FrisoDock.App.ViewModels"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:TrayFlyoutViewModel}"
        Title="FrisoDock Tray"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="Transparent"
        MaxWidth="260">

    <!--
        AllowsTransparency fica desligado para o DWM poder desenhar o acrílico atrás da janela;
        o fundo transparente vem do CompositionTarget, no FlyoutChrome.
    -->

    <Window.Resources>

        <SolidColorBrush x:Key="TextBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A0A0A0" />
        <SolidColorBrush x:Key="HoverBrush" Color="#1AFFFFFF" />

        <!--
            Grade de ícones, como a bandeja oculta do Windows: linhas de 4 colunas em vez de
            uma lista vertical, porque o que identifica o item aqui é o ícone, não o texto.
        -->
        <Style x:Key="TrayIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Padding="8">
        <StackPanel>

            <TextBlock Text="{Binding EmptyMessage}"
                       Visibility="{Binding EmptyMessageVisibility}"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Margin="8,6" />

            <ItemsControl ItemsSource="{Binding Icons}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="40" MaxWidth="160" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TrayIconViewModel}">
                        <!--
                            Sem Command nem InputBindings de propósito: os dois disparariam no
                            pressionar do mouse, e o soltar sobraria para a janela de baixo assim
                            que este flyout se fechasse. O code-behind trata a sequência inteira.
                        -->
                        <Button Style="{StaticResource TrayIconButtonStyle}"
                                PreviewMouseDown="OnIconPreviewMouseDown"
                                PreviewMouseUp="OnIconPreviewMouseUp"
                                ToolTip="{Binding DisplayName}">
                            <Image Source="{Binding Image}"
                                   Width="20"
                                   Height="20"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </Border>
</Window>
