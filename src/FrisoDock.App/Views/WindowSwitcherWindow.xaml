<Window x:Class="FrisoDock.App.Views.WindowSwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FrisoDock.App.ViewModels"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:WindowSwitcherViewModel}"
        Title="FrisoDock Switcher"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="Transparent">

    <!--
        Sem AllowsTransparency, como os flyouts: é o que deixa o DWM desenhar o acrílico atrás
        da janela e arredondar os cantos. Ver FlyoutChrome.
    -->

    <Window.Resources>

        <!--
            A veil over the acrylic, as on the jump list and for the same reason: the material
            the DWM gives transient windows is too light, raw #545454 against the #2D2D2D of
            the native flyouts. #101010 at 57% takes 84 to 45, which is the exact #2D.
        -->
        <SolidColorBrush x:Key="ScrimBrush" Color="#92101010" />


        <SolidColorBrush x:Key="TextBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A0A0A0" />
        <SolidColorBrush x:Key="SelectionBrush" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="SelectionBorderBrush" Color="#40FFFFFF" />

        <Style x:Key="TileStyle" TargetType="Border">
            <Setter Property="Width" Value="84" />
            <Setter Property="Height" Value="84" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border Padding="14,14,14,10" Background="{StaticResource ScrimBrush}" CornerRadius="8">
        <StackPanel>

            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!--
                            Quebra em linhas em vez de esticar: com muitos apps abertos, uma fila
                            única passaria da largura da tela e os ícones das pontas ficariam fora.
                        -->
                        <WrapPanel Orientation="Horizontal" MaxWidth="810" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:WindowSwitcherEntryViewModel}">
                        <Border Style="{StaticResource TileStyle}">
                            <Image Source="{Binding Image}"
                                   Width="52"
                                   Height="52"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--
                Um rótulo só, do item sob a seleção, em vez de um por ícone: com o nome debaixo
                de cada um a fila vira um bloco de texto, e o que identifica o app aqui é o ícone.
            -->
            <TextBlock Text="{Binding Caption}"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="13"
                       Margin="0,10,0,2"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Center" />

        </StackPanel>
    </Border>
</Window>
